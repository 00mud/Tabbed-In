{
  "manifest_version": 2,
  "name": "Tabuu",
  "version": "1.0.0",
  "description": "Advanced cross-device browser session manager. Log, sync, and restore tab sessions across devices.",
  "author": "Jayant Soni",

  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "48":  "icons/icon-48.png",
    "96":  "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "browser_action": {
    "default_icon": {
      "16":  "icons/icon-16.png",
      "32":  "icons/icon-32.png",
      "48":  "icons/icon-48.png"
    },
    "default_title": "Tabuu – Session Manager",
    "default_popup": "popup/popup.html"
  },

  "background": {
    "scripts": ["background/background.js"],
    "persistent": false
  },

  "permissions": [
    "tabs",
    "storage",
    "sessions",
    "notifications",
    "identity"
  ],

  "optional_permissions": [
    "bookmarks"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "tabuu@jayant.soni",
      "strict_min_version": "109.0"
    }
  },

  "content_security_policy": "script-src 'self'; object-src 'self'"
}
